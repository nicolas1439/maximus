{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vista-previa",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "const h=require('http'),f=require('fs'),p=require('path'),r=process.cwd(),t={'.html':'text/html; charset=utf-8','.css':'text/css','.js':'text/javascript','.svg':'image/svg+xml','.png':'image/png','.jpg':'image/jpeg','.webp':'image/webp','.woff2':'font/woff2','.json':'application/json'};h.createServer((q,s)=>{let u=decodeURIComponent(q.url.split('?')[0]),a=p.join(r,u);if(!a.startsWith(r)){s.writeHead(403);return s.end()}if(u.endsWith('/'))a=p.join(a,'index.html');f.readFile(a,(e,d)=>{if(e){s.writeHead(404);return s.end('404')}s.writeHead(200,{'Content-Type':t[p.extname(a)]||'application/octet-stream','Cache-Control':'no-store'});s.end(d)})}).listen(5500,'127.0.0.1')"
      ],
      "port": 5500,
      "url": "http://127.0.0.1:5500"
    }
  ]
}
